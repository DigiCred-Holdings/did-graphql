{
  "name": "@digicred-holdings/did-graphql-server",
  "version": "0.2.0",
  "description": "Server-side ZCAP-LD invocation checking for a GraphQL resource server — verifies via a tenant's own ACA-Py agent (w3c_vc zcaps/* routes), no signing/verification keys held here. Includes an explicit UNSAFE_MODE for dev/test without a live agent.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigiCred-Holdings/did-graphql.git",
    "directory": "server"
  },
  "homepage": "https://github.com/DigiCred-Holdings/did-graphql/tree/main/server#readme",
  "bugs": {
    "url": "https://github.com/DigiCred-Holdings/did-graphql/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "graphql": "^16.14.2",
    "pg": "^8.23.0"
  }
}
